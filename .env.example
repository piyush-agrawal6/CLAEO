# =============================================================================
# Core application
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=QuerySide
# Labels development UI when provider mocks are active. Never enable in prod.
NEXT_PUBLIC_MOCK_MODE=true

# =============================================================================
# Database (Neon PostgreSQL)
# Use the POOLED connection string from the Neon console.
# =============================================================================
DATABASE_URL=

# =============================================================================
# Auth.js
# Generate with: openssl rand -base64 32   (or: npx auth secret)
# =============================================================================
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth - Continue with Google on /login and /signup (docs/GOOGLE_OAUTH.md).
# Callback URL (Google Cloud Console): <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development-only helper: auto-verify emails when no email provider is
# configured. Forced OFF in production regardless of this value.
AUTH_DEV_AUTO_VERIFY=true

# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=
EMAIL_FROM=QuerySide <onboarding@example.com>

# =============================================================================
# Cache / rate limiting / job coordination (Upstash Redis)
# When unset the app falls back to a per-process in-memory store (dev only).
# =============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Providers
# =============================================================================
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Never enables real DataForSEO calls. Development default: true.
# FORCE-DISABLED in production by src/lib/env.ts hardening.
DATAFORSEO_MOCK_MODE=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
# When true, the AI layer never calls a paid provider. Development default:
# true. FORCE-DISABLED in production by src/lib/env.ts hardening.
AI_MOCK_MODE=true

# =============================================================================
# Billing (Stripe) — wired near the end of the MVP
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# Google Search Console / GA4 — integrated in later MVP phases
# OAuth client credentials are shared with Google sign-in above (reuse the
# same Google Cloud OAuth app, add the Search Console API to it).
# =============================================================================
GA4_API_SECRET=
GA4_MEASUREMENT_ID=

# =============================================================================
# Cost guards (restrictive development defaults)
# Application-level budget protection. These MUST stay conservative.
# =============================================================================
MAX_DATAFORSEO_REQUESTS_PER_DAY=25
MAX_LLM_REQUESTS_PER_DAY=100
MAX_DOMAIN_SCANS_PER_DAY=10

# Estimated provider spend guard (USD per day across the workspace).
MAX_DAILY_PROVIDER_SPEND_USD=5

# -----------------------------------------------------------------------------
# Scan engine caps (Phase 3 intelligence scans)
# Per-scan budgets. Bounds are enforced by src/lib/env.ts; dev defaults keep
# one scan ≈ $0.02 in DataForSEO data (plus counter-bounded AI requests) and
# total dev spend under ~$0.25 without approval.
# -----------------------------------------------------------------------------
# DataForSEO requests (keyword-overview batches + SERP lookups) per scan.
MAX_DATAFORSEO_REQUESTS_PER_SCAN=5
# AI prompt×engine requests per scan.
MAX_AI_REQUESTS_PER_SCAN=20
# Estimated provider spend ceiling for one scan (USD).
MAX_PROVIDER_SPEND_PER_SCAN_USD=0.10
# Tracked keywords included in one scan (search-volume metrics, up to 20).
MAX_KEYWORDS_PER_SEARCH_SCAN=10
# Keywords checked in live SERPs per scan (each = one billed SERP).
MAX_SERP_KEYWORDS_PER_SCAN=5
# Prompts evaluated with AI engines per scan.
MAX_AI_PROMPTS_PER_SCAN=10
# AI engines evaluated per scan.
MAX_AI_ENGINES_PER_SCAN=2
# Answer text truncated to this many chars before storage (evidence bound).
MAX_STORED_AI_ANSWER_CHARS=20000
# Wall-clock budget for one scan worker pass (scans resume across passes).
SCAN_WORKER_TIME_BUDGET_MS=8000

# Test safety: live provider checks in the test suite are opt-in only and
# FORCE-DISABLED in production by src/lib/env.ts hardening.
ALLOW_LIVE_PROVIDER_TESTS=false

# DataForSEO connectivity (only used when DATAFORSEO_MOCK_MODE=false).
# LIVE mode is synchronous (up to ~6s per SERP); keep the timeout generous.
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_TIMEOUT_MS=30000

# =============================================================================
# Website crawler (onboarding content analysis)
# Hard caps enforced by src/lib/env.ts — the values below are development
# defaults; production may tighten them, never remove the bounds.
# =============================================================================
# How many pages one crawl may fetch (default 10).
CRAWLER_MAX_PAGES=10
# Per-page response body cap in bytes (default 500 KB).
CRAWLER_MAX_BYTES_PER_PAGE=500000
# Manual redirect hops re-validated against the SSRF rules (default 5).
CRAWLER_MAX_REDIRECTS=5
# Wall-clock budget for one crawl (default 60 s).
CRAWLER_MAX_DURATION_MS=60000
# Per-request timeout (default 10 s).
CRAWLER_PAGE_TIMEOUT_MS=10000

# =============================================================================
# Observability
# =============================================================================
LOG_LEVEL=info
